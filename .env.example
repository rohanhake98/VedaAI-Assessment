# ==============================================================================
# VedaAI Assessment - Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for live AI question extraction - free tier compatible)
# Obtain your free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative key name
AI_API_KEY=your_gemini_api_key_here

# AI Model Selection (Default: gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash
